---
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import yaml from 'js-yaml';

import talksRaw from '../data/talks.yml?raw';

type Talk = {
  date: string;
  title: string;
  /** Named meeting or seminar series; rendered in italics. */
  event?: string;
  /** Institution and/or city; rendered upright. */
  host?: string;
  url?: string;
  type?: 'conference' | 'workshop' | 'seminar';
};

// JSON_SCHEMA keeps `date` as a plain string instead of a JS Date.
const talks = ((yaml.load(talksRaw, { schema: yaml.JSON_SCHEMA }) ?? []) as Talk[]).sort((a, b) =>
  b.date.localeCompare(a.date),
);

const byYear = new Map<string, Talk[]>();
for (const t of talks) {
  const y = t.date.slice(0, 4);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(t);
}

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const typeLabel: Record<string, string> = {
  conference: 'Conference',
  workshop: 'Workshop',
  seminar: 'Seminar',
};
---

<Page title="Invited talks" description={`Invited talks by ${site.author.name}`}>
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">invited talks</h1>
      <p class="post-description">Invited conference and workshop talks, and seminars.</p>
    </header>

    <article>
      {
        [...byYear.entries()].map(([year, items]) => (
          <section class="year-block">
            <h2 class="year">{year}</h2>
            <ol class="talk-list">
              {items.map((t) => (
                <li class="talk">
                  <div class="talk-date">{formatDate(t.date)}</div>
                  <div class="talk-body">
                    {t.type && (
                      <span class={`badge-abbr badge-${t.type}`}>{typeLabel[t.type] ?? t.type}</span>
                    )}
                    <span class="talk-title">{t.title}</span>
                    <br />
                    {(t.event || t.host) &&
                      (t.url ? (
                        <a href={t.url} target="_blank" rel="noopener noreferrer" class="talk-venue">
                          {/* kept on one line: a line break between expressions renders as a space before the comma */}
                          {t.event && <em class="talk-event">{t.event}</em>}{t.event && t.host && ', '}{t.host}
                        </a>
                      ) : (
                        <span class="talk-venue">
                          {t.event && <em class="talk-event">{t.event}</em>}{t.event && t.host && ', '}{t.host}
                        </span>
                      ))}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </article>
  </div>
</Page>

<style>
  .year-block {
    margin-top: 1.5rem;
  }
  .year {
    font-size: 1.25rem;
    color: var(--global-text-color-light);
    border-bottom: 1px solid var(--global-divider-color);
    padding-bottom: 0.3rem;
    margin-bottom: 0.75rem;
  }
  .talk-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .talk {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--global-divider-color);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .talk-date {
    color: var(--global-text-color-light);
    font-size: 0.8rem;
    white-space: nowrap;
    padding-top: 0.15rem;
  }
  .talk-title {
    font-weight: 600;
    color: var(--global-text-color);
  }
  .talk-venue {
    color: var(--global-text-color-light);
  }
  .badge-abbr {
    margin-right: 0.5rem;
  }
  /* Conference / workshop: filled accent badge. Seminar: outlined grey badge.
     The event name (talk.event) is italic, the host institution/city upright. */
  .badge-seminar {
    background-color: transparent;
    color: var(--global-text-color-light);
    border: 1px solid var(--global-text-color-light);
  }
  .talk-event {
    font-style: italic;
  }
  @media (max-width: 576px) {
    .talk {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
